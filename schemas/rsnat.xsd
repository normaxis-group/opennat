<?xml version='1.0' encoding='UTF-8'?>
<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema" elementFormDefault="qualified">
  <xs:annotation>
    <xs:documentation>Récapitulatif standardisé RSNat (nom provisoire) de la méthode OpenNAT, version 1. NORMATYS, CC BY 4.0. Généré depuis opennat/rsnat_spec.py.</xs:documentation>
  </xs:annotation>
  <xs:simpleType name="zone">
    <xs:restriction base="xs:string">
      <xs:enumeration value="atlantique"/>
      <xs:enumeration value="continentale"/>
      <xs:enumeration value="mediterraneenne"/>
      <xs:enumeration value="alpine"/>
    </xs:restriction>
  </xs:simpleType>
  <xs:simpleType name="typologie">
    <xs:restriction base="xs:string">
      <xs:enumeration value="logement"/>
      <xs:enumeration value="tertiaire"/>
      <xs:enumeration value="industrie"/>
      <xs:enumeration value="amenagement"/>
    </xs:restriction>
  </xs:simpleType>
  <xs:simpleType name="position">
    <xs:restriction base="xs:string">
      <xs:enumeration value="sol_pleine_terre"/>
      <xs:enumeration value="sol_sur_dalle"/>
      <xs:enumeration value="hors_sol_toiture"/>
      <xs:enumeration value="hors_sol_facade"/>
      <xs:enumeration value="eau"/>
      <xs:enumeration value="arbre"/>
      <xs:enumeration value="lineaire"/>
    </xs:restriction>
  </xs:simpleType>
  <xs:simpleType name="situation">
    <xs:restriction base="xs:string">
      <xs:enumeration value="reservoir"/>
      <xs:enumeration value="corridor"/>
      <xs:enumeration value="hors_trame"/>
    </xs:restriction>
  </xs:simpleType>
  <xs:simpleType name="eclairage">
    <xs:restriction base="xs:string">
      <xs:enumeration value="L0"/>
      <xs:enumeration value="L1"/>
      <xs:enumeration value="L2"/>
    </xs:restriction>
  </xs:simpleType>
  <xs:simpleType name="alimentation">
    <xs:restriction base="xs:string">
      <xs:enumeration value="naturelle"/>
      <xs:enumeration value="artificielle"/>
    </xs:restriction>
  </xs:simpleType>
  <xs:simpleType name="statut">
    <xs:restriction base="xs:string">
      <xs:enumeration value="conservee"/>
      <xs:enumeration value="creee"/>
      <xs:enumeration value="amelioree"/>
    </xs:restriction>
  </xs:simpleType>
  <xs:simpleType name="stade">
    <xs:restriction base="xs:string">
      <xs:enumeration value="J"/>
      <xs:enumeration value="M"/>
      <xs:enumeration value="A"/>
    </xs:restriction>
  </xs:simpleType>
  <xs:simpleType name="classe_diametre">
    <xs:restriction base="xs:string">
      <xs:enumeration value="petit"/>
      <xs:enumeration value="moyen"/>
      <xs:enumeration value="grand"/>
      <xs:enumeration value="tres_grand"/>
    </xs:restriction>
  </xs:simpleType>
  <xs:simpleType name="reponse">
    <xs:restriction base="xs:string">
      <xs:enumeration value="oui"/>
      <xs:enumeration value="non"/>
      <xs:enumeration value="sans_objet"/>
    </xs:restriction>
  </xs:simpleType>
  <xs:simpleType name="connexion">
    <xs:restriction base="xs:string">
      <xs:enumeration value="forte"/>
      <xs:enumeration value="moyenne"/>
      <xs:enumeration value="faible"/>
    </xs:restriction>
  </xs:simpleType>
  <xs:simpleType name="cloture">
    <xs:restriction base="xs:string">
      <xs:enumeration value="aucune"/>
      <xs:enumeration value="permeable"/>
      <xs:enumeration value="etanche"/>
    </xs:restriction>
  </xs:simpleType>
  <xs:simpleType name="regime">
    <xs:restriction base="xs:string">
      <xs:enumeration value="plantation"/>
      <xs:enumeration value="coupe_rase"/>
      <xs:enumeration value="coupe_selective"/>
      <xs:enumeration value="faible_impact"/>
    </xs:restriction>
  </xs:simpleType>
  <xs:simpleType name="phase">
    <xs:restriction base="xs:string">
      <xs:enumeration value="A1-A3"/>
      <xs:enumeration value="A4-A5"/>
      <xs:enumeration value="B"/>
      <xs:enumeration value="C"/>
      <xs:enumeration value="D"/>
    </xs:restriction>
  </xs:simpleType>
  <xs:simpleType name="etat">
    <xs:restriction base="xs:string">
      <xs:enumeration value="initial"/>
      <xs:enumeration value="projet"/>
    </xs:restriction>
  </xs:simpleType>
  <xs:simpleType name="classe_etat">
    <xs:restriction base="xs:string">
      <xs:enumeration value="bon"/>
      <xs:enumeration value="moyen"/>
      <xs:enumeration value="mauvais"/>
      <xs:enumeration value="sans_etat"/>
    </xs:restriction>
  </xs:simpleType>
  <xs:simpleType name="zone_climatique">
    <xs:restriction base="xs:string">
      <xs:enumeration value="H1a"/>
      <xs:enumeration value="H1b"/>
      <xs:enumeration value="H1c"/>
      <xs:enumeration value="H2a"/>
      <xs:enumeration value="H2b"/>
      <xs:enumeration value="H2c"/>
      <xs:enumeration value="H2d"/>
      <xs:enumeration value="H3"/>
    </xs:restriction>
  </xs:simpleType>
  <xs:simpleType name="texture">
    <xs:restriction base="xs:string">
      <xs:enumeration value="sable"/>
      <xs:enumeration value="sable_limoneux"/>
      <xs:enumeration value="limon_sableux"/>
      <xs:enumeration value="limon"/>
      <xs:enumeration value="limon_silteux"/>
      <xs:enumeration value="silt"/>
      <xs:enumeration value="limon_argilo_silteux"/>
      <xs:enumeration value="argile_silteuse"/>
      <xs:enumeration value="argile"/>
    </xs:restriction>
  </xs:simpleType>
  <xs:simpleType name="fond_mare">
    <xs:restriction base="xs:string">
      <xs:enumeration value="etanche"/>
      <xs:enumeration value="argile"/>
      <xs:enumeration value="naturel"/>
    </xs:restriction>
  </xs:simpleType>
  <xs:simpleType name="alimentation_humide">
    <xs:restriction base="xs:string">
      <xs:enumeration value="nappe"/>
      <xs:enumeration value="pluie"/>
    </xs:restriction>
  </xs:simpleType>
  <xs:simpleType name="regime_gestion">
    <xs:restriction base="xs:string">
      <xs:enumeration value="plan"/>
      <xs:enumeration value="courante"/>
      <xs:enumeration value="abandon"/>
    </xs:restriction>
  </xs:simpleType>
  <xs:simpleType name="niveau_rechauffement">
    <xs:restriction base="xs:string">
      <xs:enumeration value="2_0"/>
      <xs:enumeration value="2_7"/>
      <xs:enumeration value="4_0"/>
    </xs:restriction>
  </xs:simpleType>
  <xs:simpleType name="groupe_hydrique">
    <xs:restriction base="xs:string">
      <xs:enumeration value="gazon"/>
      <xs:enumeration value="prairie"/>
      <xs:enumeration value="xerophile"/>
      <xs:enumeration value="arbustif"/>
      <xs:enumeration value="arbore"/>
      <xs:enumeration value="conifere"/>
      <xs:enumeration value="toiture_extensive"/>
      <xs:enumeration value="humide_pluie"/>
      <xs:enumeration value="mare"/>
    </xs:restriction>
  </xs:simpleType>
  <xs:element name="RSNat">
    <xs:annotation>
      <xs:documentation>Récapitulatif standardisé de l'étude nature OpenNAT</xs:documentation>
    </xs:annotation>
    <xs:complexType>
      <xs:sequence>
        <xs:element name="version_methode" type="xs:string">
          <xs:annotation>
            <xs:documentation>Version de la méthode (OpenNAT 1)</xs:documentation>
          </xs:annotation>
        </xs:element>
        <xs:element name="version_donnees" type="xs:string">
          <xs:annotation>
            <xs:documentation>Empreinte SHA-256 des tables de donnees/</xs:documentation>
          </xs:annotation>
        </xs:element>
        <xs:element name="graine" type="xs:integer">
          <xs:annotation>
            <xs:documentation>Graine du générateur aléatoire</xs:documentation>
          </xs:annotation>
        </xs:element>
        <xs:element name="date_calcul" type="xs:date">
          <xs:annotation>
            <xs:documentation>Date du calcul</xs:documentation>
          </xs:annotation>
        </xs:element>
        <xs:element name="Entree_Projet">
          <xs:annotation>
            <xs:documentation>Données d'entrée (partie 1, chapitre 4)</xs:documentation>
          </xs:annotation>
          <xs:complexType>
            <xs:sequence>
              <xs:element name="Projet">
                <xs:annotation>
                  <xs:documentation>Identification et contexte</xs:documentation>
                </xs:annotation>
                <xs:complexType>
                  <xs:sequence>
                    <xs:element name="identifiant" type="xs:string">
                      <xs:annotation>
                        <xs:documentation>Identifiant du projet</xs:documentation>
                      </xs:annotation>
                    </xs:element>
                    <xs:element name="nom" type="xs:string">
                      <xs:annotation>
                        <xs:documentation>Nom de l'opération</xs:documentation>
                      </xs:annotation>
                    </xs:element>
                    <xs:element name="adresse" minOccurs="0" type="xs:string">
                      <xs:annotation>
                        <xs:documentation>Adresse</xs:documentation>
                      </xs:annotation>
                    </xs:element>
                    <xs:element name="commune_insee" minOccurs="0" type="xs:string">
                      <xs:annotation>
                        <xs:documentation>Code INSEE de la commune</xs:documentation>
                      </xs:annotation>
                    </xs:element>
                    <xs:element name="latitude" minOccurs="0" type="xs:decimal">
                      <xs:annotation>
                        <xs:documentation>Latitude WGS 84 (°)</xs:documentation>
                      </xs:annotation>
                    </xs:element>
                    <xs:element name="longitude" minOccurs="0" type="xs:decimal">
                      <xs:annotation>
                        <xs:documentation>Longitude WGS 84 (°)</xs:documentation>
                      </xs:annotation>
                    </xs:element>
                    <xs:element name="zone_biogeographique" type="zone">
                      <xs:annotation>
                        <xs:documentation>Zone biogéographique (fiche A02)</xs:documentation>
                      </xs:annotation>
                    </xs:element>
                    <xs:element name="departement" minOccurs="0" type="xs:string">
                      <xs:annotation>
                        <xs:documentation>Département du site</xs:documentation>
                      </xs:annotation>
                    </xs:element>
                    <xs:element name="altitude" minOccurs="0" type="xs:decimal">
                      <xs:annotation>
                        <xs:documentation>Altitude du site (fiche A43) (m)</xs:documentation>
                      </xs:annotation>
                    </xs:element>
                    <xs:element name="zone_climatique" type="zone_climatique">
                      <xs:annotation>
                        <xs:documentation>Zone climatique RE2020 (fiche A43)</xs:documentation>
                      </xs:annotation>
                    </xs:element>
                    <xs:element name="texture_sol" minOccurs="0" type="texture">
                      <xs:annotation>
                        <xs:documentation>Texture du sol du site (fiche A48)</xs:documentation>
                      </xs:annotation>
                    </xs:element>
                    <xs:element name="profondeur_sol" minOccurs="0" type="xs:decimal">
                      <xs:annotation>
                        <xs:documentation>Profondeur de sol du site (fiche A48) (m)</xs:documentation>
                      </xs:annotation>
                    </xs:element>
                    <xs:element name="annee_debut_chantier" type="xs:integer">
                      <xs:annotation>
                        <xs:documentation>Année de début du chantier (fiche A58)</xs:documentation>
                      </xs:annotation>
                    </xs:element>
                    <xs:element name="mois_debut_chantier" type="xs:integer">
                      <xs:annotation>
                        <xs:documentation>Mois de début du chantier, 1 à 12 (fiche A58)</xs:documentation>
                      </xs:annotation>
                    </xs:element>
                    <xs:element name="mois_destruction" minOccurs="0" type="xs:integer">
                      <xs:annotation>
                        <xs:documentation>Mois des défrichements, abattages et comblements (fiche A57)</xs:documentation>
                      </xs:annotation>
                    </xs:element>
                    <xs:element name="plan_gestion_annees" minOccurs="0" type="xs:integer">
                      <xs:annotation>
                        <xs:documentation>Durée du plan de gestion écologique (fiche A55) (an)</xs:documentation>
                      </xs:annotation>
                    </xs:element>
                    <xs:element name="typologie" type="typologie">
                      <xs:annotation>
                        <xs:documentation>Typologie de l'opération</xs:documentation>
                      </xs:annotation>
                    </xs:element>
                    <xs:element name="rsee_empreinte" minOccurs="0" type="xs:string">
                      <xs:annotation>
                        <xs:documentation>Empreinte SHA-256 du RSEE repris, s'il y en a un</xs:documentation>
                      </xs:annotation>
                    </xs:element>
                    <xs:element name="date_etude" type="xs:date">
                      <xs:annotation>
                        <xs:documentation>Date de l'étude</xs:documentation>
                      </xs:annotation>
                    </xs:element>
                  </xs:sequence>
                </xs:complexType>
              </xs:element>
              <xs:element name="Parcelle">
                <xs:annotation>
                  <xs:documentation>Parcelle ou unité foncière</xs:documentation>
                </xs:annotation>
                <xs:complexType>
                  <xs:sequence>
                    <xs:element name="surface" type="xs:decimal">
                      <xs:annotation>
                        <xs:documentation>Surface de la parcelle S_p (m²)</xs:documentation>
                      </xs:annotation>
                    </xs:element>
                    <xs:element name="surface_vegetalisee_rsee" minOccurs="0" type="xs:decimal">
                      <xs:annotation>
                        <xs:documentation>Surface végétalisée déclarée au RSEE (contrôle) (m²)</xs:documentation>
                      </xs:annotation>
                    </xs:element>
                    <xs:element name="surface_impermeable_rsee" minOccurs="0" type="xs:decimal">
                      <xs:annotation>
                        <xs:documentation>Surface imperméabilisée déclarée au RSEE (contrôle) (m²)</xs:documentation>
                      </xs:annotation>
                    </xs:element>
                    <xs:element name="cbs_plu" minOccurs="0" type="xs:decimal">
                      <xs:annotation>
                        <xs:documentation>Coefficient de biotope imposé par le PLU</xs:documentation>
                      </xs:annotation>
                    </xs:element>
                    <xs:element name="pleine_terre_plu" minOccurs="0" type="xs:decimal">
                      <xs:annotation>
                        <xs:documentation>Part de pleine terre imposée par le PLU</xs:documentation>
                      </xs:annotation>
                    </xs:element>
                  </xs:sequence>
                </xs:complexType>
              </xs:element>
              <xs:element name="Batiment_Collection" minOccurs="0">
                <xs:annotation>
                  <xs:documentation>Bâtiments de l'opération</xs:documentation>
                </xs:annotation>
                <xs:complexType>
                  <xs:sequence>
                    <xs:element name="Batiment" minOccurs="0" maxOccurs="unbounded">
                      <xs:annotation>
                        <xs:documentation>Bâtiment</xs:documentation>
                      </xs:annotation>
                      <xs:complexType>
                        <xs:sequence>
                          <xs:element name="index" type="xs:integer">
                            <xs:annotation>
                              <xs:documentation>Index du bâtiment</xs:documentation>
                            </xs:annotation>
                          </xs:element>
                          <xs:element name="nom" minOccurs="0" type="xs:string">
                            <xs:annotation>
                              <xs:documentation>Nom</xs:documentation>
                            </xs:annotation>
                          </xs:element>
                          <xs:element name="sref" type="xs:decimal">
                            <xs:annotation>
                              <xs:documentation>Surface de référence (m²)</xs:documentation>
                            </xs:annotation>
                          </xs:element>
                          <xs:element name="emprise_au_sol" type="xs:decimal">
                            <xs:annotation>
                              <xs:documentation>Emprise au sol (m²)</xs:documentation>
                            </xs:annotation>
                          </xs:element>
                          <xs:element name="duree_chantier" type="xs:decimal">
                            <xs:annotation>
                              <xs:documentation>Durée du chantier (mois)</xs:documentation>
                            </xs:annotation>
                          </xs:element>
                          <xs:element name="Ges_Collection">
                            <xs:annotation>
                              <xs:documentation>Émissions des contributeurs composants et chantier (indicateur 101)</xs:documentation>
                            </xs:annotation>
                            <xs:complexType>
                              <xs:sequence>
                                <xs:element name="Ges" maxOccurs="unbounded">
                                  <xs:annotation>
                                    <xs:documentation>Émission d'une phase</xs:documentation>
                                  </xs:annotation>
                                  <xs:complexType>
                                    <xs:sequence>
                                      <xs:element name="phase" type="phase">
                                        <xs:annotation>
                                          <xs:documentation>Phase du cycle de vie</xs:documentation>
                                        </xs:annotation>
                                      </xs:element>
                                      <xs:element name="valeur" type="xs:decimal">
                                        <xs:annotation>
                                          <xs:documentation>Valeur de l'indicateur 101 (kg CO2 éq./m² Sref)</xs:documentation>
                                        </xs:annotation>
                                      </xs:element>
                                    </xs:sequence>
                                  </xs:complexType>
                                </xs:element>
                              </xs:sequence>
                            </xs:complexType>
                          </xs:element>
                          <xs:element name="Pollution_Collection" minOccurs="0">
                            <xs:annotation>
                              <xs:documentation>Indicateurs 106 à 109 et 116</xs:documentation>
                            </xs:annotation>
                            <xs:complexType>
                              <xs:sequence>
                                <xs:element name="Pollution" minOccurs="0" maxOccurs="unbounded">
                                  <xs:annotation>
                                    <xs:documentation>Indicateur de pollution d'une phase</xs:documentation>
                                  </xs:annotation>
                                  <xs:complexType>
                                    <xs:sequence>
                                      <xs:element name="code" type="xs:integer">
                                        <xs:annotation>
                                          <xs:documentation>Code de l'indicateur (106, 107, 108, 109, 116)</xs:documentation>
                                        </xs:annotation>
                                      </xs:element>
                                      <xs:element name="phase" type="phase">
                                        <xs:annotation>
                                          <xs:documentation>Phase</xs:documentation>
                                        </xs:annotation>
                                      </xs:element>
                                      <xs:element name="valeur" type="xs:decimal">
                                        <xs:annotation>
                                          <xs:documentation>Valeur (unité de l'annexe II par m² Sref)</xs:documentation>
                                        </xs:annotation>
                                      </xs:element>
                                    </xs:sequence>
                                  </xs:complexType>
                                </xs:element>
                              </xs:sequence>
                            </xs:complexType>
                          </xs:element>
                        </xs:sequence>
                      </xs:complexType>
                    </xs:element>
                  </xs:sequence>
                </xs:complexType>
              </xs:element>
              <xs:element name="Tache_Collection" minOccurs="0">
                <xs:annotation>
                  <xs:documentation>Taches d'habitat et leur contexte (fiches A17 à A19)</xs:documentation>
                </xs:annotation>
                <xs:complexType>
                  <xs:sequence>
                    <xs:element name="Tache" minOccurs="0" maxOccurs="unbounded">
                      <xs:annotation>
                        <xs:documentation>Tache</xs:documentation>
                      </xs:annotation>
                      <xs:complexType>
                        <xs:sequence>
                          <xs:element name="identifiant" type="xs:string">
                            <xs:annotation>
                              <xs:documentation>Identifiant de tache</xs:documentation>
                            </xs:annotation>
                          </xs:element>
                          <xs:element name="surface_exterieure" minOccurs="0" type="xs:decimal">
                            <xs:annotation>
                              <xs:documentation>Surface végétalisée extérieure contiguë (m²)</xs:documentation>
                            </xs:annotation>
                          </xs:element>
                          <xs:element name="connexion" minOccurs="0" type="connexion">
                            <xs:annotation>
                              <xs:documentation>Connexion déclarée</xs:documentation>
                            </xs:annotation>
                          </xs:element>
                          <xs:element name="distance_espace_naturel" minOccurs="0" type="xs:decimal">
                            <xs:annotation>
                              <xs:documentation>Distance bord à bord à l'espace naturel le plus proche (m)</xs:documentation>
                            </xs:annotation>
                          </xs:element>
                          <xs:element name="surface_espace_naturel" minOccurs="0" type="xs:decimal">
                            <xs:annotation>
                              <xs:documentation>Surface de cet espace (m²)</xs:documentation>
                            </xs:annotation>
                          </xs:element>
                          <xs:element name="cloture" minOccurs="0" type="cloture">
                            <xs:annotation>
                              <xs:documentation>Clôture de la tache</xs:documentation>
                            </xs:annotation>
                          </xs:element>
                        </xs:sequence>
                      </xs:complexType>
                    </xs:element>
                  </xs:sequence>
                </xs:complexType>
              </xs:element>
              <xs:element name="Etat_Initial">
                <xs:annotation>
                  <xs:documentation>État initial du site</xs:documentation>
                </xs:annotation>
                <xs:complexType>
                  <xs:sequence>
                    <xs:element name="Unite_Collection">
                      <xs:annotation>
                        <xs:documentation>Unités</xs:documentation>
                      </xs:annotation>
                      <xs:complexType>
                        <xs:sequence>
                          <xs:element name="Unite" minOccurs="0" maxOccurs="unbounded">
                            <xs:annotation>
                              <xs:documentation>Unité d'habitat</xs:documentation>
                            </xs:annotation>
                            <xs:complexType>
                              <xs:sequence>
                                <xs:element name="identifiant" type="xs:string">
                                  <xs:annotation>
                                    <xs:documentation>Identifiant unique de l'unité dans le projet</xs:documentation>
                                  </xs:annotation>
                                </xs:element>
                                <xs:element name="identifiant_geometrique" minOccurs="0" type="xs:string">
                                  <xs:annotation>
                                    <xs:documentation>Identifiant de l'objet géométrique correspondant (import futur)</xs:documentation>
                                  </xs:annotation>
                                </xs:element>
                                <xs:element name="code_habitat" type="xs:string">
                                  <xs:annotation>
                                    <xs:documentation>Code de nomenclature_habitats.csv ou code EUNIS rattaché (fiche A04)</xs:documentation>
                                  </xs:annotation>
                                </xs:element>
                                <xs:element name="position" type="position">
                                  <xs:annotation>
                                    <xs:documentation>Position de saisie (fiche A04)</xs:documentation>
                                  </xs:annotation>
                                </xs:element>
                                <xs:element name="surface" type="xs:decimal">
                                  <xs:annotation>
                                    <xs:documentation>Surface ; houppier pour un arbre, longueur x largeur pour une haie (fiches A13 à A16) (m²)</xs:documentation>
                                  </xs:annotation>
                                </xs:element>
                                <xs:element name="epaisseur_substrat" minOccurs="0" type="xs:decimal">
                                  <xs:annotation>
                                    <xs:documentation>Épaisseur de substrat, sur dalle ou hors-sol (cm)</xs:documentation>
                                  </xs:annotation>
                                </xs:element>
                                <xs:element name="hauteur_facade" minOccurs="0" type="xs:decimal">
                                  <xs:annotation>
                                    <xs:documentation>Hauteur végétalisée d'une façade (m)</xs:documentation>
                                  </xs:annotation>
                                </xs:element>
                                <xs:element name="longueur" minOccurs="0" type="xs:decimal">
                                  <xs:annotation>
                                    <xs:documentation>Longueur d'une haie ou d'une façade (m)</xs:documentation>
                                  </xs:annotation>
                                </xs:element>
                                <xs:element name="largeur" minOccurs="0" type="xs:decimal">
                                  <xs:annotation>
                                    <xs:documentation>Largeur d'une haie (m)</xs:documentation>
                                  </xs:annotation>
                                </xs:element>
                                <xs:element name="nombre_arbres" minOccurs="0" type="xs:integer">
                                  <xs:annotation>
                                    <xs:documentation>Nombre d'arbres d'une unité arbre</xs:documentation>
                                  </xs:annotation>
                                </xs:element>
                                <xs:element name="classe_diametre" minOccurs="0" type="classe_diametre">
                                  <xs:annotation>
                                    <xs:documentation>Classe de diamètre des arbres</xs:documentation>
                                  </xs:annotation>
                                </xs:element>
                                <xs:element name="stade" minOccurs="0" type="stade">
                                  <xs:annotation>
                                    <xs:documentation>Stade d'un type ligneux</xs:documentation>
                                  </xs:annotation>
                                </xs:element>
                                <xs:element name="situation" minOccurs="0" type="situation">
                                  <xs:annotation>
                                    <xs:documentation>Situation dans la trame verte et bleue (fiche A02)</xs:documentation>
                                  </xs:annotation>
                                </xs:element>
